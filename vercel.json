{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "klarus.io"
        }
      ],
      "destination": "https://www.klarus.io/$1",
      "permanent": true
    },
    {
      "source": "/index-5",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index-dark",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index-5-dark",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact-1",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/contact-2",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(index|ScrollSmoother|ScrollTrigger)-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(assets/css|assets/js|scripts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(png|jpg|jpeg|webp|svg|gif|woff2|woff|ttf|webm|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(og-image.jpg|icon-192.png|icon-512.png|apple-touch-icon.png|favicon-32.png|favicon-64.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "trailingSlash": false
}
