# Production domain used for canonicals, sitemap, schema (defaults to https://www.klarus.io)
VITE_SITE_URL=https://www.klarus.io
# GA4 measurement ID (defaults to the production ID in src/lib/analytics.ts)
VITE_GA_MEASUREMENT_ID=G-N1KCHPMKYZ
# Search engine verification tokens (the meta tags are added only when these are set)
VITE_GSC_VERIFICATION=
VITE_BING_VERIFICATION=
